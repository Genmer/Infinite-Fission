windows.release.x86_64 = "res://native/bin/libfission_space_grid.windows.template_release.x86_64.dll"
windows.template_release.x86_64 = "res://native/bin/libfission_space_grid.windows.template_release.x86_64.dll"
android.template_debug.arm64 = "res://native/bin/libfission_space_grid.android.template_debug.arm64.so"
android.template_release.arm64 = "res://native/bin/libfission_space_grid.android.template_release.arm64.so"
